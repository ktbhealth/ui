		"embla-carousel-vue": "^8.6.0",
		"lucide-vue-next": "^1.0.0",
		"reka-ui": "^2.11.0",
		"vue-sonner": "^2.0.9",
		"vue": "^3.5.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
