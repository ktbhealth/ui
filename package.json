{
	"name": "@ktbhealth/ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "KTB Health design system: Tailwind v4 tokens + React (shadcn) and Vue (shadcn-vue) components",
	"exports": {
		"./styles/globals.css": "./packages/tailwind/src/globals.css",
		"./tailwind/globals.css": "./packages/tailwind/src/globals.css",
		"./components/*": [
			"./packages/react/src/components/*.tsx",
			"./packages/react/src/components/*.ts"
		],
		"./lib/*": [
			"./packages/react/src/lib/*.ts",
			"./packages/react/src/lib/*.tsx"
		],
		"./hooks/*": [
			"./packages/react/src/hooks/*.ts",
			"./packages/react/src/hooks/*.tsx"
		],
		"./react": "./packages/react/src/index.ts",
		"./vue": "./packages/vue/src/index.ts",
		"./tokens.css": "./packages/tailwind/src/generated/tokens.css",
		"./tokens.ts": "./packages/tailwind/src/generated/tokens.ts",
		"./tokens.json": "./packages/tailwind/tokens/tokens.json",
		"./tokens": "./packages/tailwind/src/generated/tokens.ts"
	},
	"dependencies": {
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"shadcn": "^4.23.0",
		"@base-ui/react": "^1.9.0",
		"@radix-ui/react-use-controllable-state": "^1.3.0",
		"@rive-app/react-webgl2": "^4.38.1",
		"@shadcn/react": "^0.3.1",
		"@streamdown/cjk": "^1.0.4",
		"@streamdown/code": "^2.0.0",
		"@streamdown/math": "^1.0.3",
		"@streamdown/mermaid": "^1.0.3",
		"@xyflow/react": "^12.12.1",
		"ai": "^7.0.163",
		"ansi-to-react": "^6.2.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.2",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.5.0",
		"lucide-react": "^0.544.0",
		"media-chrome": "^4.19.4",
